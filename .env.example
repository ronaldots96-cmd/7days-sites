# Optional canonical URL override, without a trailing slash.
# On Cloudflare Pages this can stay empty while using the temporary pages.dev URL;
# the build automatically falls back to CF_PAGES_URL.
SITE_URL=

# Keep false on pages.dev. Change to true only after the final domain is connected.
SITE_INDEXABLE=false

# Optional. The Cloudflare build falls back to CF_PAGES_COMMIT_SHA for cache busting.
ASSET_VERSION=

# Optional absolute HTTPS endpoint used by the briefing form.
BRIEFING_WEBHOOK_URL=
