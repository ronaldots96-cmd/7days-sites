# Canonical production URL, without a trailing slash.
SITE_URL=https://7days-sites.pages.dev

# Use true only in Production; keep false in Preview.
SITE_INDEXABLE=true

# Optional. The Cloudflare build falls back to CF_PAGES_COMMIT_SHA for cache busting.
ASSET_VERSION=

# Public, same-origin Pages Function used by both forms.
FORMS_WEBHOOK_URL=/api/forms

# Private upstream used only by the Pages Function. Configure it as an
# encrypted Cloudflare Production variable; it is never rendered in HTML.
N8N_LEAD_WEBHOOK_URL=https://n8n.v4lisboatech.com.br/webhook/7days-leadform
# Encrypted Cloudflare secret. Use the same value in the n8n Webhook Header Auth
# credential, with header name `Authorization` and value `Bearer <secret>`.
N8N_WEBHOOK_SECRET=

# Google Tag Manager container used on the home and onboarding pages.
GTM_CONTAINER_ID=GTM-MMBHLWJQ
